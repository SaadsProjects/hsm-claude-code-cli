# Template for the dashboard's Streamlit secrets (contract C7). Placeholders
# only: never put a real value in this file.
#
# Local run: copy it to .streamlit/secrets.toml (git-ignored) and leave the
# placeholders in place. The sign-in gate then shows its sign-in screen. A
# real sign-in needs your own Google OAuth client and your email in
# HSM_ALLOWED_EMAILS. Hosted apps enter these values in the app's Secrets
# settings on Streamlit Community Cloud, one set per environment.
#
# The token-signing secret is deliberately not set here, so a local copy never
# shadows .env.local (written by scripts/dev-secret.sh). On a hosted app, set
# it to a value of at least 32 bytes, unique to that app and different from
# cookie_secret:
# HSM_SIGNING_SECRET = "<at least 32 bytes, unique to this app>"

# Exact email addresses only; no domains or wildcards.
HSM_ALLOWED_EMAILS = ["<your-email@example.com>"]

[auth]
redirect_uri = "<http://localhost:8501/oauth2callback locally; the app URL plus /oauth2callback when hosted>"
cookie_secret = "<random, different from HSM_SIGNING_SECRET>"

[auth.google]
client_id = "<your OAuth client id>"
client_secret = "<your OAuth client secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
