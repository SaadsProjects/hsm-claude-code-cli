# Development and CI dependencies. Install locally with:
#   pip install --require-hashes -r requirements-dev.txt
# Compile with:
#   uv pip compile requirements-dev.in --universal --generate-hashes --python-version 3.10 --no-header -o requirements-dev.txt
-r requirements.in

# `mcp` (the official Model Context Protocol Python SDK) runs
# mcp_server/hsm_tools.py and tests/test_mcp_tools.py. Pinned to 1.x: the
# 2.x line renamed FastMCP to MCPServer with a different API. The [cli] extra
# pulls in typer/uvicorn for the optional `mcp dev` Inspector command.
# Claude Code supplies the model connection; no anthropic SDK is needed.
mcp[cli]==1.30.0

# ruff is the linter and formatter; .claude/hooks/lint_before_commit.py runs
# it before every commit and fails closed if it is missing. CI runs the same
# pinned version.
ruff==0.16.8

pytest==9.1.1
pytest-rerunfailures  # CI retries a failing test once (--reruns 1)
coverage  # line coverage with subprocess measurement (.coveragerc)

# CI security gates
bandit
pip-audit
cvss  # scores OSV CVSS vectors in scripts/filter_audit.py
tomli; python_version < "3.11"  # security-exceptions.toml on Python 3.10
